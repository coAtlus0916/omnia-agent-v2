# Optional stable product root. Do not put secrets in this file.
OMNIA_AGENT_PRODUCT_ROOT=

# Optional Microsoft Edge executable override.
OMNIA_EDGE_PATH=

# AI Provider and Remote settings are configured in the real Settings UI.
# API keys and Shell Remote tokens are Windows safeStorage protected.

# Standalone v5 Bridge deployment (never reuse v4 values/endpoints).
OMNIA_V5_BRIDGE_HOST=127.0.0.1
OMNIA_V5_BRIDGE_PORT=18785
OMNIA_V5_BRIDGE_ADMIN_TOKEN=
OMNIA_V5_BRIDGE_TOKEN_SECRET=

# Remote Connector pairing is performed interactively by PairRemoteConnector.cmd.
# One-time pairing codes must not be persisted in an env file.
